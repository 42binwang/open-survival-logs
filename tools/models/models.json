{
  "wp": "WP-P1-models",
  "resolution": "1k",
  "recipe": "polyhaven-gltf",
  "families": {
    "sofa": "sofas and couches",
    "armchair": "upholstered armchairs",
    "rack": "metal shelving racks",
    "bookshelf": "wooden bookshelves and shelf units",
    "cabinet": "cabinets, dressers, nightstands and drawers",
    "table": "dining and side tables",
    "coffeetable": "low coffee tables",
    "desk": "desks",
    "chair": "chairs and stools",
    "bed": "beds and bed frames",
    "tv": "televisions",
    "stove": "cooking stoves",
    "generator": "fuel generators",
    "crate": "boxes, crates and toolboxes",
    "barrel": "barrels and jerrycans",
    "bucket": "buckets and baskets",
    "plant": "potted plants and planters",
    "workbench": "tool carts, tool chests and workshop storage",
    "appliance": "small appliances and electronics",
    "lamp": "lamps and light fittings",
    "wall": "wall decorations",
    "heater": "heating and climate units",
    "exterior": "street furniture and outdoor props",
    "misc": "miscellaneous small props"
  },
  "classes": {
    "$comment": "params.class (the triangle budget of tools/art-metrics/standard.mjs TRIANGLES) by family: pieces of furniture, or props (clutter, small appliances, wall decorations); a prop larger than propMaxM along any axis is furniture. Every model is tier regular (ART.md §3: 256 px/m for floors, walls, furniture and clutter).",
    "furniture": [
      "sofa",
      "armchair",
      "rack",
      "bookshelf",
      "cabinet",
      "table",
      "coffeetable",
      "desk",
      "chair",
      "bed",
      "tv",
      "stove",
      "generator",
      "workbench",
      "heater",
      "exterior"
    ],
    "prop": [
      "crate",
      "barrel",
      "bucket",
      "plant",
      "appliance",
      "lamp",
      "wall",
      "misc"
    ],
    "propMaxM": 1.0,
    "tier": "regular"
  },
  "runtime": {
    "$comment": "the renderer (src/render3d/models.js) draws no model with more triangles than maxTriangles, except these families; the manifest marks them params.skip",
    "maxTriangles": 45000,
    "exceptFamilies": [
      "bed"
    ]
  },
  "textures": {
    "$comment": "KTX2 from the locked 1k JPEGs (tools/models/textures.py). Each image is sized for the texel density of its tier over the UV islands that sample it (ART.md §3, ±10 %), on a lattice of sizes q × 2^k (q 8…15) so that levels stay whole 4 × 4 blocks, at most the source size. Encoder settings are the material library's (tools/materials/targets.json encode). The JPEGs stay as the glTF fallback images. A map ETC1S cannot keep inside the albedo limits or off the roughness ends is UASTC (the library's mask settings, 'fallback'); a normal map whose RDO pushes a level past the normal-length limits is UASTC without RDO ('normalExact').",
    "maxSize": 1024,
    "minSize": 32,
    "encode": {
      "baseColor": [
        "--encode",
        "basis-lz",
        "--clevel",
        "4",
        "--qlevel",
        "255"
      ],
      "normal": [
        "--encode",
        "uastc",
        "--uastc-quality",
        "4",
        "--uastc-rdo",
        "--uastc-rdo-l",
        "0.4",
        "--uastc-rdo-m",
        "--zstd",
        "18"
      ],
      "orm": [
        "--encode",
        "basis-lz",
        "--clevel",
        "4",
        "--qlevel",
        "255",
        "--no-endpoint-rdo",
        "--no-selector-rdo"
      ],
      "normalExact": [
        "--encode",
        "uastc",
        "--uastc-quality",
        "4",
        "--zstd",
        "18"
      ],
      "fallback": [
        "--encode",
        "uastc",
        "--uastc-quality",
        "3",
        "--zstd",
        "18"
      ]
    }
  },
