// Concert toms, mallets: Versilian Community Sample Library (VCSL) (CC0), sgossner/VCSL@c1ea7bcc3c, folder 'Membranophones/Struck Membranophones'.
// Written by tools/music/build.mjs (tools/music/instruments.mjs); played by tools/music/sampler.mjs.
// Gain staging: loudest layer calibrated to -20 LUFS-M on Tom 1/Mallet/TomH_HitM_v4_rr1_Mid.wav (measured -25.0).
<control> default_path=../../../assets/cache/vcsl/toms/
<global> pitch_keytrack=0 ampeg_release=0.6 amp_veltrack=70 loop_mode=one_shot offset_auto=1 volume=5
<group> lovel=1 hivel=80
