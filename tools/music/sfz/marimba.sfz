// Marimba: VSCO 2 Community Edition (CC0), sgossner/VSCO-2-CE@440300901d, folder 'Percussion/Marimba'.
// Written by tools/music/build.mjs (tools/music/instruments.mjs); played by tools/music/sampler.mjs.
// Gain staging: loudest layer calibrated to -20 LUFS-M on Marimba_hit_Outrigger_C4_loud_01.wav (measured -28.5).
<control> default_path=../../../assets/cache/vsco2ce/marimba/
<global> ampeg_release=0.6 amp_veltrack=75 loop_mode=one_shot fil_type=lpf_2p cutoff=3000 fil_veltrack=4000 offset_auto=1 volume=8.5
<group> lovel=1 hivel=127
<region> lokey=0 hikey=44 pitch_keycenter=41 sample=Marimba_hit_Outrigger_F1_loud_01.wav
<region> lokey=45 hikey=51 pitch_keycenter=48 sample=Marimba_hit_Outrigger_C2_loud_01.wav
<region> lokey=52 hikey=57 pitch_keycenter=55 sample=Marimba_hit_Outrigger_G2_loud_01.wav
<region> lokey=58 hikey=62 pitch_keycenter=59 sample=Marimba_hit_Outrigger_B2_loud_01.wav
<region> lokey=63 hikey=68 pitch_keycenter=65 sample=Marimba_hit_Outrigger_F3_loud_01.wav
<region> lokey=69 hikey=75 pitch_keycenter=72 sample=Marimba_hit_Outrigger_C4_loud_01.wav
<region> lokey=76 hikey=81 pitch_keycenter=79 sample=Marimba_hit_Outrigger_G4_loud_01.wav
<region> lokey=82 hikey=86 pitch_keycenter=83 sample=Marimba_hit_Outrigger_B4_loud_01.wav
<region> lokey=87 hikey=92 pitch_keycenter=89 sample=Marimba_hit_Outrigger_F5_loud_01.wav
