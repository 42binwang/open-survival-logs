// Snare drum, snares on: VSCO 2 Community Edition (CC0), sgossner/VSCO-2-CE@440300901d, folder 'Percussion'.
// Written by tools/music/build.mjs (tools/music/instruments.mjs); played by tools/music/sampler.mjs.
// Gain staging: loudest layer calibrated to -20 LUFS-M on Snare2-HitSN_v9_rr1_Sum.wav (measured -17.5).
<control> default_path=../../../assets/cache/vsco2ce/snare/
<global> pitch_keytrack=0 ampeg_release=0.3 amp_veltrack=60 loop_mode=one_shot offset_auto=1 volume=-2.5
<group> lovel=1 hivel=30
<region> lokey=38 hikey=38 pitch_keycenter=38 seq_length=2 seq_position=1 sample=Snare2-HitSN_v1_rr1_Sum.wav
<region> lokey=38 hikey=38 pitch_keycenter=38 seq_length=2 seq_position=2 sample=Snare2-HitSN_v1_rr2_Sum.wav
<group> lovel=31 hivel=60
<region> lokey=38 hikey=38 pitch_keycenter=38 seq_length=2 seq_position=1 sample=Snare2-HitSN_v3_rr1_Sum.wav
<region> lokey=38 hikey=38 pitch_keycenter=38 seq_length=2 seq_position=2 sample=Snare2-HitSN_v3_rr2_Sum.wav
<group> lovel=61 hivel=90
<region> lokey=38 hikey=38 pitch_keycenter=38 seq_length=2 seq_position=1 sample=Snare2-HitSN_v5_rr1_Sum.wav
<region> lokey=38 hikey=38 pitch_keycenter=38 seq_length=2 seq_position=2 sample=Snare2-HitSN_v5_rr2_Sum.wav
<group> lovel=91 hivel=110
<region> lokey=38 hikey=38 pitch_keycenter=38 seq_length=2 seq_position=1 sample=Snare2-HitSN_v7_rr1_Sum.wav
<region> lokey=38 hikey=38 pitch_keycenter=38 seq_length=2 seq_position=2 sample=Snare2-HitSN_v7_rr2_Sum.wav
<group> lovel=111 hivel=127
<region> lokey=38 hikey=38 pitch_keycenter=38 seq_length=2 seq_position=1 sample=Snare2-HitSN_v9_rr1_Sum.wav
<region> lokey=38 hikey=38 pitch_keycenter=38 seq_length=2 seq_position=2 sample=Snare2-HitSN_v9_rr2_Sum.wav
