// Concert bass drum: Versilian Community Sample Library (VCSL) (CC0), sgossner/VCSL@c1ea7bcc3c, folder 'Membranophones/Struck Membranophones/Bass Drum 2'.
// Written by tools/music/build.mjs (tools/music/instruments.mjs); played by tools/music/sampler.mjs.
// Gain staging: loudest layer calibrated to -20 LUFS-M on bassdrum_hit_ff.wav (measured -20.3).
<control> default_path=../../../assets/cache/vcsl/bass-drum/
<global> pitch_keytrack=0 ampeg_release=1.2 amp_veltrack=80 loop_mode=one_shot offset_auto=1 volume=0.3
<group> lovel=1 hivel=127
<region> lokey=33 hikey=33 pitch_keycenter=33 sample=bassdrum_cresc_short.wav
<region> lokey=34 hikey=34 pitch_keycenter=34 sample=bassdrum_cresc_med.wav
<group> lovel=1 hivel=40
<region> lokey=36 hikey=36 pitch_keycenter=36 seq_length=2 seq_position=1 sample=bassdrum_hit_pp1.wav
<region> lokey=36 hikey=36 pitch_keycenter=36 seq_length=2 seq_position=2 sample=bassdrum_hit_pp2.wav
<group> lovel=41 hivel=70
<region> lokey=36 hikey=36 pitch_keycenter=36 seq_length=2 seq_position=1 sample=bassdrum_hit_mp1.wav
<region> lokey=36 hikey=36 pitch_keycenter=36 seq_length=2 seq_position=2 sample=bassdrum_hit_mp2.wav
<group> lovel=71 hivel=95
<region> lokey=36 hikey=36 pitch_keycenter=36 seq_length=2 seq_position=1 sample=bassdrum_hit_mf1.wav
<region> lokey=36 hikey=36 pitch_keycenter=36 seq_length=2 seq_position=2 sample=bassdrum_hit_mf2.wav
<group> lovel=96 hivel=112
<region> lokey=36 hikey=36 pitch_keycenter=36 sample=bassdrum_hit_f.wav
<group> lovel=113 hivel=127
<region> lokey=36 hikey=36 pitch_keycenter=36 sample=bassdrum_hit_ff.wav
