// Concert harp: VSCO 2 Community Edition (CC0), sgossner/VSCO-2-CE@440300901d, folder 'Strings/Harp'.
// Written by tools/music/build.mjs (tools/music/instruments.mjs); played by tools/music/sampler.mjs.
// Gain staging: loudest layer calibrated to -20 LUFS-M on KSHarp_F4_mf.wav (measured -27.7).
<control> default_path=../../../assets/cache/vsco2ce/harp/
<global> ampeg_release=0.9 amp_veltrack=70 loop_mode=one_shot fil_type=lpf_2p cutoff=6000 fil_veltrack=3600 offset_auto=1 volume=7.7
<group> lovel=1 hivel=127
<region> lokey=0 hikey=41 pitch_keycenter=40 sample=KSHarp_E1_f.wav
