// Written by tools/music/build.mjs (tools/music/instruments.mjs); played by tools/music/sampler.mjs.
// Gain staging: loudest layer calibrated to -20 LUFS-M on gong_fff.wav (measured -14.4).
<control> default_path=../../../assets/cache/vcsl/gong/
<global> pitch_keytrack=0 ampeg_release=4 amp_veltrack=75 loop_mode=one_shot offset_auto=1 volume=-5.6
<group> lovel=1 hivel=60
<region> lokey=57 hikey=57 pitch_keycenter=57 sample=gong_p.wav
<group> lovel=61 hivel=90
<region> lokey=57 hikey=57 pitch_keycenter=57 sample=gong_mf.wav
<group> lovel=91 hivel=112
<region> lokey=57 hikey=57 pitch_keycenter=57 sample=gong_f.wav
<group> lovel=113 hivel=127
<region> lokey=57 hikey=57 pitch_keycenter=57 sample=gong_fff.wav
