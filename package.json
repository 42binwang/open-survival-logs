{
  "name": "survival-logs",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A browser recreation of Survival Log, the zombie-apocalypse hoarding survival sim.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "e2e": "playwright test",
    "gate": "node tools/gate.mjs",
    "assets:verify": "node tools/fetch-assets.mjs --verify",
    "asset-lock": "node tools/asset-lock.mjs",
    "coverage": "node tools/coverage.mjs",
    "art-metrics": "node tools/art-metrics.mjs",
    "visual": "node tools/visual/run.mjs",
    "budgets": "node tools/budgets/run.mjs",
    "balance": "node tools/balance/run.mjs --seeds 50",
    "audio": "node tools/audio/build.mjs",
    "materials:build": "tools/materials/build.sh",
    "materials:previews": "tools/materials/build.sh --previews",
    "data": "python3 tools/build_data.py",
    "check": "node tools/check_syntax.mjs && node --test tests/*.test.js",
    "code-coverage": "node tools/code-coverage.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "meshoptimizer": "1.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
